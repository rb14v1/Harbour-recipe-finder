# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---
# USE_SQLITE=True runs entirely on SQLite with no Postgres/pgvector needed
# (the embedding column becomes a JSONField). Set to False to use Postgres;
# Postgres must have `CREATE EXTENSION vector` available (pgvector installed
# on the server) for the first migration to succeed.
USE_SQLITE=True
POSTGRES_DB=recipe_finder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / embeddings ---
# Leave OPENAI_API_KEY unset to run the entire app in deterministic stub
# mode: no network calls, no cost, reproducible embeddings/answers. Set it
# to enable real OpenAI embeddings + chat completions.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-sol
SEARCH_TOP_K_DEFAULT=5

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
